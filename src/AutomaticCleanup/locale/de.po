#: ../plugin.py:130 ../plugin.py:200 ../plugin.py:506
msgid "Automatic System Cleanup Setup"
msgstr "Automatische Systembereinigung einrichten"

#: ../plugin.py:177
msgid "Cancel"
msgstr "Abbrechen"

#: ../plugin.py:223
msgid ""
"Cleanup timerlist, orphaned movie files and stored setting backups automatically.\n"
"\n"
"Modify the settings to match your preferences. More detailed explanations given with each adjustable option."
msgstr ""
"Automatische Bereinigung der Timerliste, verwaisten Film-Dateien und Einstellungs-Sicherungen.\n"
"\n"
"Ändern Sie die Einstellungen wunschgemäß. Nähere Erläuterungen sind bei jeder Einstellungsoption angegeben."

#: ../plugin.py:141
msgid "Delete crashlogs"
msgstr "Crashlogs löschen"

#: ../plugin.py:139
msgid "Delete orphaned movie files"
msgstr "Verwaiste Film-Dateien löschen"

#: ../plugin.py:135
msgid "Delete system setting backups"
msgstr "Einstellungs-Sicherungen löschen"

#: ../plugin.py:156 ../plugin.py:159
msgid "Delete timerlist entries"
msgstr "Timerlisten-Einträge löschen"

#: ../plugin.py:179
msgid "Help"
msgstr "Hilfe"

#: ../plugin.py:140
msgid "If enabled, orphaned movie files will be automatically deleted from movie directories."
msgstr "Wenn diese Option aktiviert ist, werden verwaiste Film-Dateien automatisch gelöscht."

#: ../plugin.py:143
msgid "Maximum number of crashlogs"
msgstr "Maximale Anzahl Crashlogs "

#: ../plugin.py:137
msgid "Maximum number of system setting backups"
msgstr "Maximale Anzahl Einstellungs-Sicherungen"

#: ../plugin.py:138
msgid "Maximum number of system setting backups to keep, regardless of retention period."
msgstr "Höchstzahl der aufzuhebenden Einstellungs-Sicherungen, ungeachtet der Aufbewahrungsfrist."

#: ../plugin.py:178
msgid "OK"
msgstr "OK"

#: ../plugin.py:142 ../plugin.py:144
msgid "Sorry, this feature is not available due to license reasons. To get the full version, please search the web for \"dreambox automaticcleanup.\""
msgstr "Dieses Feature ist aus Lizenzgründen leider nicht verfügbar. Die Vollversion ist im web zu finden unter \"dreambox automaticcleanup\"."

#: ../plugin.py:160
msgid "Specify, how long expired timer list entries shall be kept at most. Deactivated repeat timer entries won't be deleted ever."
msgstr "Wie lange sollen abgelaufene Timer längstens aufbewahrt werden? Deaktivierte Wiederholungstimer werden nicht gelöscht."

#: ../plugin.py:136
msgid "Specify, how long system setting backups shall be kept at most (even if maximum number is not yet exceeded). Latest backup will be kept anyway!"
msgstr "Wie lange sollen Einstellungs-Sicherungen aufbewahrt werden (auch wenn die maximale Anzahl noch nicht erreicht ist)? Die letzte Sicherung wird niemals gelöscht!"

#: ../plugin.py:502
msgid "System cleanup"
msgstr "Systembereinigung"

#: ../plugin.py:157
msgid "Timerlist cleanup is enabled in EMC plugin! To avoid crashes, we won't delete entries whilst this option is enabled in EMC."
msgstr "Bereinigung der Timerliste ist im EMC Plugin aktiviert! Um Abstürze zu verhindern, werden hier keine Einträge gelöscht, solange diese Option in EMC gesetzt ist."

#: ../plugin.py:200
msgid "Ver."
msgstr "Ver."

